        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst timestamp = new Date().toISOString();\n\nconst validas = [];\nconst invalidas = [];\n\nfor (const item of items) {\n  const t = item.json;\n  const errores = [];\n\n  // Validaciones\n  if (!t.id)                    errores.push('Falta id');\n  if (!t.titulo)                errores.push('Falta titulo');\n  if (!t.responsable)           errores.push('Falta responsable');\n  if (!t.fecha_vencimiento)     errores.push('Falta fecha_vencimiento');\n  if (!t.prioridad)             errores.push('Falta prioridad');\n\n  // Validar email\n  if (t.email_responsable) {\n    const emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(t.email_responsable);\n    if (!emailOk) errores.push('Email inválido');\n  }\n\n  // Detectar vencimiento\n  let vencida = false;\n  let venceHoy = false;\n  if (t.fecha_vencimiento) {\n    const hoy = new Date();\n    hoy.setHours(0,0,0,0);\n    const fecha = new Date(t.fecha_vencimiento);\n    vencida   = fecha < hoy;\n    venceHoy  = fecha.toDateString() === hoy.toDateString();\n  }\n\n  const enriquecida = {\n    ...t,\n    _meta: {\n      processedAt: timestamp,\n      vencida,\n      venceHoy,\n      errores\n    }\n  };\n\n  if (errores.length > 0) {\n    invalidas.push({ json: enriquecida });\n  } else {\n    validas.push({ json: enriquecida });\n  }\n}\n\nconsole.log(`Válidas: ${validas.length} | Inválidas: ${invalidas.length}`);\n\nreturn validas;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
