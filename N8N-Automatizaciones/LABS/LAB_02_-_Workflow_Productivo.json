    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst hoy = new Date().toLocaleDateString('es-AR');\n\nlet filas = '';\n\nfor (const item of items) {\n  const t = item.json;\n  const estado = t._meta.vencida ? '🔴 VENCIDA' : '🟡 VENCE HOY';\n  const prioridad = t.prioridad === 'alta' ? '⚠️ Alta' \n                  : t.prioridad === 'media' ? '🔵 Media' \n                  : '⬇️ Baja';\n\n  filas += `\n    <tr>\n      <td style=\"padding:8px;border:1px solid #ddd\">${t.id}</td>\n      <td style=\"padding:8px;border:1px solid #ddd\">${t.titulo}</td>\n      <td style=\"padding:8px;border:1px solid #ddd\">${t.responsable}</td>\n      <td style=\"padding:8px;border:1px solid #ddd\">${prioridad}</td>\n      <td style=\"padding:8px;border:1px solid #ddd\">${t.fecha_vencimiento}</td>\n      <td style=\"padding:8px;border:1px solid #ddd\">${estado}</td>\n    </tr>`;\n}\n\nconst html = `\n<h2>📋 Resumen Diario de Tareas — ${hoy}</h2>\n<p>Se encontraron <strong>${items.length} tarea(s)</strong> que requieren atención:</p>\n<table style=\"border-collapse:collapse;width:100%\">\n  <thead style=\"background:#2c3e50;color:white\">\n    <tr>\n      <th style=\"padding:8px\">ID</th>\n      <th style=\"padding:8px\">Título</th>\n      <th style=\"padding:8px\">Responsable</th>\n      <th style=\"padding:8px\">Prioridad</th>\n      <th style=\"padding:8px\">Vencimiento</th>\n      <th style=\"padding:8px\">Estado</th>\n    </tr>\n  </thead>\n  <tbody>${filas}</tbody>\n</table>\n<p style=\"color:#888;font-size:12px\">Generado automáticamente por n8n — ${new Date().toISOString()}</p>\n`;\n\nreturn [{ json: { html, totalTareas: items.length, fecha: hoy } }];"
      },
