    {
      "parameters": {
        "jsCode": "\nconst workflows = $input.first().json.data;\nconst items = [];\n\nfor (const wf of workflows) {\n  items.push({\n    json: {\n      name: wf.name,\n      id: wf.id\n    },\n    binary: {\n      data: {\n        data: Buffer.from(JSON.stringify(wf, null, 2)).toString('base64'),\n        mimeType: 'application/json',\n        fileName: wf.name.replace(/[^a-zA-Z0-9_\\-]/g, '_') + '.json',\n        fileExtension: 'json'\n      }\n    }\n  });\n}\n\nreturn items;\n"
      },
