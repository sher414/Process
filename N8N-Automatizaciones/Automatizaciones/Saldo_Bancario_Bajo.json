      {
        "parameters": {
          "httpMethod": "POST",
          "path": "alerta-saldo",
          "options": {}
        },
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          -240,
          0
        ],
        "id": "dbd5e7f9-2217-4197-bf88-a08a10f738a1",
        "name": "Post.Hoppscoth.Pruebas",
        "webhookId": "f018e4fc-2f73-432f-b57c-9f6f665ad063"
      },
      {
        "parameters": {
          "jsCode": "// Tomamos el primer item que llega del webhook\n// $input es el dato que viene del nodo anterior\n// .first() agarra el primer registro (en este caso hay uno solo)\n// .json accede al contenido JSON de ese registro\nconst item = $input.first().json;\n// N8N a veces mete los datos del POST dentro de \"body\"\n// y a veces directamente en el raíz del json\n// Por eso usamos el operador ?. (optional chaining) para intentar\n// primero item.body.cuenta, y si no existe, item.cuenta\n// Si ninguno existe, devolvemos '' (string vacío como fallback)\nconst cuenta = item.body?.cuenta || item.cuenta || '';\n// Hacemos lo mismo para saldo y minimo, pero además usamos parseFloat()\n// porque lo que llega del POST es un STRING (\"15000\")\n// y necesitamos un NÚMERO para poder comparar con el operador \n// El operador ?? (nullish coalescing) devuelve el lado derecho\n// solo si el izquierdo es null o undefined (más preciso que ||)\nconst saldo  = parseFloat(item.body?.saldo  ?? item.saldo  ?? 0);\nconst minimo = parseFloat(item.body?.minimo ?? item.minimo ?? 0);\n// Acá está la lógica central del flujo\n// Comparamos saldo con minimo → devuelve true o false\n// Este valor es el que va a usar el nodo IF para decidir qué rama tomar\nconst bajoDeLimite = saldo < minimo;\n// Calculamos cuánto falta para llegar al mínimo\n// Solo tiene sentido calcularlo si está bajo el límite\n// Si está OK, guardamos 0 para no confundir\n// ✅ Calculamos la diferencia primero, luego la usamos\nconst diferencia = bajoDeLimite ? (minimo - saldo) : 0;\n\n// Guardamos la fecha y hora exacta en que se procesó el registro\n// toISOString() devuelve formato universal: \"2026-05-15T14:30:00.000Z\"\nconst procesado_al = new Date().toISOString();\n// Retornamos el item transformado para que el siguiente nodo lo use\n// N8N siempre espera un array de objetos con la forma { json: {...} }\nreturn [{\n  json: {\n    cuenta,           // nombre de la cuenta\n    saldo,            // saldo actual (número)\n    minimo,           // mínimo requerido (número)\n    diferencia,       // cuánto falta (0 si está OK)\n    bajo_de_limite: bajoDeLimite,   // true o false → lo usa el IF\n    procesado_al      // timestamp del momento de procesamiento\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          112,
