    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.text;\n\n// Defensivo: limpia markdown si la IA lo envolvió en ```json ... ```\nconst match = raw.match(/\\[[\\s\\S]*\\]/);\nif (match) {\n  raw = match[0];\n}\n\nconst tareas = JSON.parse(raw);\n\n// Cada tarea como ítem separado de n8n (fan-out)\nreturn tareas.map(t => ({ json: t }));"
      },
