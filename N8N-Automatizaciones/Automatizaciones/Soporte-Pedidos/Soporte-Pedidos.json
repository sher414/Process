      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst remitente = item.From || '';\n// Limpiamos el asunto eliminando los \"Re:\" acumulados\nconst asuntoRaw = item.Subject || '';\nconst asunto = asuntoRaw.replace(/^(Re:\\s*)+/gi, '').trim();\nconst cuerpo = item.snippet || '';\nconst emailId = item.id || '';\nconst fecha = new Date(parseInt(item.internalDate)).toISOString();\n\nconst matchPedido = asunto.match(/#(\\d+)/);\nconst numeroPedido = matchPedido ? matchPedido[1] : 'Sin número';\n\nconst ticketId = `TICKET-${Date.now()}`;\n\nreturn [{\n  json: {\n    ticketId,\n    numeroPedido,\n    remitente,\n    asunto,\n    cuerpo,\n    emailId,\n    fecha\n  }\n}];"
      },
