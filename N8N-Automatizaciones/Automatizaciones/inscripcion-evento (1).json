      "parameters": {
        "jsCode": "const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nconst item = $input.first().json;\n\nconst nombre = item.body?.nombre || item.nombre || '';\nconst email = item.body?.email || item.email || '';\nconst ciudad = item.body?.ciudad || item.ciudad || '';\nconst empresa = item.body?.empresa || item.empresa || 'Sin empresa';\n\nconst emailValido = emailRegex.test(email);\nconst procesadoAl = new Date().toISOString();\n\nconst nombreFormateado = nombre\n  .split(' ')\n  .map(p => p.charAt(0).toUpperCase() + p.slice(1))\n  .join(' ');\n\nreturn [{\n  json: {\n    nombre: nombreFormateado,\n    email: email,\n    ciudad: ciudad,\n    empresa: empresa,\n    email_valido: emailValido,\n    procesado_al: procesadoAl\n  }\n}];"
