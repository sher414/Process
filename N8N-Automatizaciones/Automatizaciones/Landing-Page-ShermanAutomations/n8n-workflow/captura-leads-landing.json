    {
      "parameters": {
        "jsCode": "// Anti-bot: honeypot + rate limit por IP\nconst body = $('Webhook').item.json.body;\nconst ip = $('Webhook').item.json.headers['x-real-ip'] || 'unknown';\n\n// IPs excluidas del rate limit (tu propia IP, para pruebas sin restricción)\nconst whitelist = ['186.127.195.205'];\n\n// Honeypot: si el campo trampa viene con contenido, es un bot\nif (body.website && body.website.trim() !== '') {\n  return [{ json: { allowed: false, reason: 'honeypot' } }];\n}\n\n// Si la IP está en la whitelist, se salta el rate limit directamente\nif (whitelist.includes(ip)) {\n  return [{ json: { allowed: true } }];\n}\n\n// Rate limit: máximo 3 envíos por IP cada 5 minutos\nconst staticData = $getWorkflowStaticData('global');\nstaticData.rateLimit = staticData.rateLimit || {};\n\nconst now = Date.now();\nconst windowMs = 5 * 60 * 1000; // 5 minutos\nconst maxRequests = 3;\n\nconst history = (staticData.rateLimit[ip] || []).filter(ts => now - ts < windowMs);\n\nif (history.length >= maxRequests) {\n  return [{ json: { allowed: false, reason: 'rate_limit' } }];\n}\n\nhistory.push(now);\nstaticData.rateLimit[ip] = history;\n\nreturn [{ json: { allowed: true } }];"
      },
