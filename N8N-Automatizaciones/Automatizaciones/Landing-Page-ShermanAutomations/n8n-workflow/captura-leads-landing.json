    {
      "parameters": {
        "jsCode": "// Traemos el dato original del formulario, sin importar los nodos que pasamos en el medio\nconst data = $('Webhook').item.json.body;\n\n// Contador que vamos a ir sumando según las señales de interés del lead\nlet score = 0;\n\n// +2 si dejó teléfono (campo opcional) y no es solo espacios en blanco\nif (data.telefono && data.telefono.trim() !== '') score += 2;\n\n// +2 si eligió modalidad de largo plazo (mayor compromiso)\nif (data.modalidad === 'largo_plazo') score += 2;\n\n// +1 si eligió freelance o temporal (compromiso medio)\nif (data.modalidad === 'freelance' || data.modalidad === 'temporal') score += 1;\n\n// +3 si el tipo de proyecto es prioritario para tu negocio (automatización)\nif (data.tipo_proyecto === 'automatizacion') score += 3;\n\n// +3 si el tipo de proyecto es prioritario para tu negocio (consultoría)\nif (data.tipo_proyecto === 'consultoria') score += 3;\n\n// +1 si es IA aplicada (interesante, pero no tan prioritario como los dos de arriba)\nif (data.tipo_proyecto === 'ia') score += 1;\n\n// +1 si es una consulta de auditorías\nif (data.tipo_proyecto === 'auditorias') score += 1;\n\n// Corte de clasificación: 4 o más puntos = lead caliente, menos = lead frío\nconst clasificacion = score >= 4 ? 'caliente' : 'frio';\n\n// n8n necesita que el Code node devuelva un array de objetos con esta forma { json: {...} }\nreturn [{\n  json: {\n    ...data,\n    score: score,\n    clasificacion: clasificacion\n  }\n}];"
      },
